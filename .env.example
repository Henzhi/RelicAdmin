# 复制此文件为 .env 并填入真实值（.env 不会被提交到 Git）
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)
#
# 容器内应用以 prod profile 运行（docker-compose.yml 通过 SPRING_PROFILES_ACTIVE 注入），
# 以下变量与 application-prod.yml 的占位符一一对应。

# 运行 profile（保持 prod 即可）
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai

# MySQL（生产/云端数据库）
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_mysql_password
# 云端数据库通常可关 SSL 走账号密码；需要加密通道时改回 true
DB_SSL=false

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0
REDIS_SSL=false

# JWT 四端独立密钥（base64，≥32 字节；可用 `openssl rand -base64 48` 生成）
JWT_ADMIN_SECRET_KEY=change_me_base64_key_at_least_32_bytes
JWT_KNOWLEDGE_SECRET_KEY=change_me_base64_key_at_least_32_bytes
JWT_MUSEUM_SECRET_KEY=change_me_base64_key_at_least_32_bytes
JWT_USER_SECRET_KEY=change_me_base64_key_at_least_32_bytes

# 阿里云 OSS
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your_oss_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
ALIYUN_OSS_BUCKET_NAME=your_bucket

# 知识问答子系统地址（管理端问答页面的代理目标）
QA_BASE_URL=http://host.docker.internal:8000

# 可选：备份文件 AES 加密密钥（≥32 字符），留空则不加密
BACKUP_ENCRYPT_KEY=
